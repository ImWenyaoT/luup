{
  "name": "luup-frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "trustedDependencies": [
    "@swc/core"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "biome check --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true ./",
    "lint:ci": "biome ci .",
    "generate:client": "cd ../backend && UV_CACHE_DIR=.cache/uv uv run python -m scripts.export_openapi && cd ../frontend && openapi-ts -i ../backend/openapi.json -o src/client -c @hey-api/client-fetch",
    "check:client": "bun run generate:client && git diff --exit-code -- ../backend/openapi.json src/client",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.14",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "1.61.1",
    "@tanstack/router-plugin": "^1.168.18",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react-swc": "4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  }
}
