    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": ">=1.61.1",
    "@types/node": "^22.13.9",
    "@types/react": ">=19.2.17",
    "@types/react-dom": ">=19.2.3",
