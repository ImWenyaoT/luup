{
  "name": "@luup/server",
  "version": "0.1.0",
  "private": true,
  "description": "Luup harness backend: deterministic orchestration over @openai/agents, SQLite fact store, B1-B4 verifiers.",
  "type": "module",
  "scripts": {
    "dev": "LUUP_RUNTIME=deterministic LUUP_DATABASE=../../outputs/runtime/typescript-runs.db tsx watch src/main.ts",
    "dev:live": "LUUP_DATABASE=../../outputs/runtime/typescript-runs.db tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && tsx test/coverage-gate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@openai/agents": "0.17.0",
    "elysia": "^1.4.30",
    "fast-xml-parser": "^5.11.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
