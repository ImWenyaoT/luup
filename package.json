{
  "name": "luup",
  "private": true,
  "scripts": {
    "dev": "pnpm run \"/^dev:(api|web)$/\"",
    "dev:api": "LUUP_RUNTIME=deterministic node --env-file-if-exists=.env --experimental-strip-types --watch apps/server/src/main.ts",
    "dev:api:live": "node --env-file-if-exists=.env --experimental-strip-types --watch apps/server/src/main.ts",
    "dev:web": "pnpm --filter @luup/frontend dev",
    "build": "pnpm --filter @luup/frontend build",
    "start": "pnpm build && node --env-file-if-exists=.env --experimental-strip-types apps/server/src/main.ts",
    "canary": "node --env-file-if-exists=.env --experimental-strip-types apps/server/src/canary.ts",
    "batch": "node --env-file-if-exists=.env --experimental-strip-types apps/server/src/batch/runner.ts",
    "eval": "node --experimental-strip-types apps/server/src/eval/metrics.ts",
    "typecheck": "pnpm --filter @luup/server typecheck && pnpm --filter @luup/frontend typecheck",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm --filter @luup/server test:coverage",
    "test:e2e": "pnpm --filter @luup/frontend test:e2e",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write 'apps/**/*.{ts,tsx,json,css,html}' package.json knip.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check 'apps/**/*.{ts,tsx,json,css,html}' package.json knip.json .oxlintrc.json .oxfmtrc.json",
    "knip": "knip --treat-config-hints-as-errors",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run knip && pnpm build && pnpm test:coverage && pnpm --filter @luup/frontend test"
  },
  "devDependencies": {
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.15.1"
  },
  "packageManager": "pnpm@11.15.1"
}
