# 百炼 OpenAI-compatible 接线；不要在此文件写真实密钥。
#
# 两种用法，任选其一（也可混用）：
#   1. `cp .env.example .env` 后填值——支持从当前工作目录加载 `.env`，
#      从仓根跑 `pnpm run start` / `pnpm run batch` / `pnpm run canary` 都读得到，无需 export。
#   2. 直接 export 同名系统环境变量。
# 同名时**系统环境变量优先**；
# .env 不存在也能正常启动，只有 live 模式缺凭据才报错。
#
# 唯一读取点是 apps/server/src/seams/model.ts；新增模型相关变量都加在那里，不要散落到别处。
QWEN_API_KEY=your-key
QWEN_BASE_URL=your-openai-compatible-base-url
LUUP_MODEL_ID=qwen3.7-plus

# live 模式必填：保护 POST /api/runs 与 PUT /api/config。客户端必须带
# `Authorization: Bearer <token>`；只有 deterministic 本地开发可以不设置。
LUUP_API_TOKEN=
# 可选：进程内正在执行或排队的 Run 上限，默认 8；满载时 API 返回 429。
LUUP_MAX_QUEUED_RUNS=8

# 服务监听地址。Tunnel/反向代理 origin 推荐保留 loopback；只有在容器或独立网卡
# 已有防火墙/安全组时才改为 0.0.0.0。公网安全边界不由这个变量提供。
LUUP_HOSTNAME=127.0.0.1
PORT=8000
